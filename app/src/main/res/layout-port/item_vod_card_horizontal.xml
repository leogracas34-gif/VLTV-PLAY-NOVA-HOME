<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPoster"
    android:layout_width="120dp"
    android:layout_height="178dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="4dp"
    android:focusable="true"
    android:clickable="true"
    app:cardBackgroundColor="#111118"
    app:cardCornerRadius="10dp"
    app:cardElevation="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_card_bottom"/>

        <!-- ✅ NOVO: logo do título (clearlogo TMDB), estilo Netflix.
             Some por padrão; o adapter mostra ela e esconde tvTitle
             quando o item tem logoUrl salva. -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:shadowColor="#CC000000"
            android:shadowRadius="4"
            android:shadowDx="0"
            android:shadowDy="1"/>

        <!-- ✅ Selo de status — barra sólida de largura total embaixo do
             pôster, igual Netflix (degradê dourado da marca em vez de
             vermelho). Linha 2 só aparece pro caso "Nova Temporada Em
             Breve" (ex: "NOVA TEMPORADA" + "EM BREVE" empilhados). -->
        <LinearLayout
            android:id="@+id/llBadgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvBadgeNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="NOVIDADE"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.03"
                android:paddingHorizontal="14dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_badge_status_bar"/>

            <TextView
                android:id="@+id/tvBadgeNewLine2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="EM BREVE"
                android:textColor="@color/mocha_gold_darkest"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.03"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:background="@color/white"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ✅ Selo TOP 10 encaixado no canto superior esquerdo, sem
             margem, como se fizesse parte da própria capa (canto
             arredondado igual ao do card). -->
        <TextView
            android:id="@+id/tvBadgeTop10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="0dp"
            android:text="TOP 10"
            android:textColor="@color/black"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            android:paddingStart="9dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_badge_top10"
            android:visibility="gone"/>

    </FrameLayout>

</androidx.cardview.widget.CardView>
