<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="110dp"
    android:layout_height="160dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="4dp"
    android:focusable="true"
    android:clickable="true">

    <!-- Número enorme deslocado para a esquerda (estilo Netflix Top 10) -->
    <TextView
        android:id="@+id/tvRankNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:text="1"
        android:textColor="#1AFFFFFF"
        android:textSize="110sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:layout_marginStart="-8dp"
        android:layout_marginBottom="-16dp"
        android:includeFontPadding="false"/>

    <!-- Card do poster à direita do número -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="80dp"
        android:layout_height="118dp"
        android:layout_gravity="top|end"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#111118">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_card_bottom"/>

            <!-- ✅ NOVO: selo de status (Novidade/Nova Temporada/Novo
                 Episódio/Em Breve) — mesma prioridade e mesmos textos do
                 card de "Filmes/Séries Para Você" (ver HomeRowAdapter),
                 só reduzido pro tamanho menor deste card (80dp de
                 largura). Só um selo por vez; a 2ª linha ("EM BREVE") só
                 aparece nas variantes "...Em Breve". -->
            <LinearLayout
                android:id="@+id/llBadgeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="4dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvBadgeNew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="NOVIDADE"
                    android:textColor="@color/white"
                    android:textSize="5.5sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_section_pill"/>

                <TextView
                    android:id="@+id/tvBadgeNewLine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center"
                    android:text="EM BREVE"
                    android:textColor="@color/brand_red_darkest"
                    android:textSize="5.5sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:maxLines="1"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:background="@drawable/bg_section_pill"
                    android:backgroundTint="@color/white"
                    android:visibility="gone"/>

            </LinearLayout>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- Título invisível (mantido para o adapter) -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"/>

</FrameLayout>
