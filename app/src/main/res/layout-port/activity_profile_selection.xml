<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#000000">

    <!-- ══════════════════════════════════════════════════════
         BACKGROUND DINÂMICO

         scaleType="centerCrop" — preenche a tela toda
         sem deixar preto, igual Netflix.

         O posicionamento vertical é controlado via código:
         a imagem é deslocada para cima usando translationY
         negativo, mostrando mais da parte central/baixa
         do backdrop (onde fica o personagem).
         ══════════════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/imgDynamicBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.0"/>

    <!-- Gradiente: transparente no topo, escurece para o meio
         e fica mais forte embaixo onde ficam os perfis -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_profile_scrim"/>

    <!-- ══════════════════════════════════════════════════════
         PAINEL INFERIOR — cor E cantos superiores (o "arco")
         controlados 100% via Kotlin (ProfilesActivity.aplicarPainelInicial
         / animarCorPainel), acompanhando a cor dominante da capa em
         destaque no momento — por isso não tem android:background
         fixo aqui, senão o Kotlin sempre teria que sobrescrever.
         ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutPainelPerfis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Logo do filme/série (PT-BR via TMDB) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp">

            <ImageView
                android:id="@+id/imgDynamicLogo"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:visibility="gone"
                android:alpha="0"/>

            <TextView
                android:id="@+id/tvDynamicTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:shadowColor="#DD000000"
                android:shadowRadius="10"
                android:maxLines="2"
                android:ellipsize="end"
                android:alpha="0"/>
        </FrameLayout>

        <!-- Badge: ícone TOP10/NOVO + texto -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/imgBadgeIcon"
                android:layout_width="36dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_top10"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvDynamicBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#DDDDDD"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#AA000000"
                android:shadowRadius="6"
                android:alpha="0"/>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════
             PAINEL SÓLIDO DOS PERFIS — essa é a peça com o "arco"
             (cantos superiores em raio elíptico) + cor extraída da capa
             em destaque via Palette. É uma camada SEPARADA da área
             de título/logo acima (que continua transparente, sem
             curva) — só assim o arredondado fica visível, porque
             precisa de uma cor sólida/opaca por trás pra fazer
             contraste com a imagem.
             Cor e cantos controlados 100% via Kotlin
             (aplicarPainelInicial / animarCorPainel) — por isso não
             tem android:background fixo aqui.

             ✅ AJUSTE: paddingTop reduzido de 14dp → 6dp, aproximando
             o avatar do topo do arco (igual à distância curta da Netflix).
             ══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutProfilesPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="24dp">

            <!-- "Escolha o seu perfil" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:text="Escolha o seu perfil"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:letterSpacing="0.04"/>

            <!-- Fileira de avatares — centralizada, largura ajustada ao
                 conteúdo (wrap_content) pra ficar no meio da tela igual
                 a Netflix. Se houver mais perfis do que cabe na largura
                 da tela, rola horizontalmente sozinho. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProfiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:overScrollMode="never"/>

            <!-- Botões ADICIONAR e EDITAR — largura fixa (não mais esticados
                 pra preencher a tela toda), igual à proporção da Netflix:
                 dois quadrados compactos lado a lado, centralizados.
                 ✅ AJUSTE: marginTop reduzido de 14dp → 8dp, subindo junto
                 com os avatares (mesma proporção de aproximação do arco). -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/layoutAddProfile"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_profile_btn"
                    android:paddingVertical="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adicionar"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutEditProfiles"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_profile_btn"
                    android:paddingVertical="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✎"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/tvEditProfiles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Editar"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
