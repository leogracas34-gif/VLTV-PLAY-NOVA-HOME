<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/btnBackMovieDownload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Download do Filme"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingEnd="40dp" />
        </LinearLayout>

        <!-- Poster -->
        <androidx.cardview.widget.CardView
            android:layout_width="160dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="6dp">

            <ImageView
                android:id="@+id/imgMoviePoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvMovieName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvMovieStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#A6FFFFFF"
            android:textSize="14sp" />

        <!-- ✅ NOVO: Progresso de EXIBIÇÃO (quanto do filme já foi assistido) -->
        <LinearLayout
            android:id="@+id/layoutWatchedProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMovieWatchedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assistido"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <ProgressBar
                android:id="@+id/pbMovieWatched"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progressTint="#E50914"
                android:progressBackgroundTint="#33FFFFFF" />

            <TextView
                android:id="@+id/tvMovieWatchedInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#A6FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Progresso do DOWNLOAD -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/pbMovieProgress"
                android:layout_width="96dp"
                android:layout_height="96dp"
                app:indicatorColor="#E50914"
                app:trackColor="#33FFFFFF"
                app:trackThickness="6dp"
                android:max="100" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvMoviePercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Ações -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="28dp">

            <Button
                android:id="@+id/btnMoviePrimary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="▶  Assistir"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="#FFFFFF"
                android:textColor="#000000" />

            <Button
                android:id="@+id/btnMovieSecondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Excluir Download"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="#2E2E38"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnVerDetalhesFilme"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Ver Detalhes do Filme"
                android:textAllCaps="false"
                android:backgroundTint="#1A1A1A"
                android:textColor="#AAAAAA" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
