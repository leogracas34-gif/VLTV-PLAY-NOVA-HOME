<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_premium"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Ícone de escudo, reforça o contexto de proteção infantil -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️"
        android:textSize="32sp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvTituloSairKids"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sair da Área Infantil?"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tvMensagemSairKids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Você vai voltar para a tela de seleção de perfil, onde pode escolher qualquer perfil."
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/btnCancelarSairKids"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancelar"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:background="@drawable/bg_profile_btn"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnConfirmarSairKids"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Sair"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:background="@drawable/bg_botao_sair_premium"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
