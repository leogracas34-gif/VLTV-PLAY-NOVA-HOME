<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#111118"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:layout_width="148dp"
                android:layout_height="84dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0A0A14">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgEpisodeThumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@android:color/darker_gray"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_episode_thumb"/>

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_circle"
                        android:alpha="0.85"
                        android:contentDescription="Play"/>

                    <ProgressBar
                        android:id="@+id/pbEpisodeProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_gravity="bottom"
                        android:progressBackgroundTint="#44FFFFFF"
                        android:progressTint="#FF0000"
                        android:progress="0"
                        android:max="100"
                        android:indeterminate="false"
                        android:visibility="gone"/>

                </FrameLayout>

            </androidx.cardview.widget.CardView>

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/tvEpisodeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end"
                android:letterSpacing="0.01"/>

            <TextView
                android:id="@+id/tvEpisodePlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"/>

        </LinearLayout>

        <!-- ✅ NOVO: botão de download com 3 estados visuais —
             1) Seta pra baixo (ainda não baixado) → imgDownloadIcon visível
             2) Anel de progresso (baixando)       → pbEpisodeDownload visível
             3) Ícone "baixado" (concluído)         → imgDownloadIcon visível
                (troca o src/tint via código, é o mesmo ImageView)
             Controlado 100% pelo SeriesDetailsActivity/EpisodeAdapter —
             não precisa mais ficar oculto por padrão. -->
        <FrameLayout
            android:id="@+id/btnDownloadEpisode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imgDownloadIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/stat_sys_download"
                app:tint="#AAFFFFFF"/>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/pbEpisodeDownload"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:visibility="gone"
                app:indicatorColor="#E50914"
                app:trackColor="#33FFFFFF"
                app:trackThickness="3dp"
                app:indicatorSize="28dp"/>

        </FrameLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
