<?xml version="1.0" encoding="utf-8"?>
<!-- NOVO HOME — slide do banner hero. Estrutura de conteúdo igual (logo/
     título, tags, Assistir/Detalhes), mas com um gradiente mais
     cinematográfico (fica escuro só perto do texto, não a imagem toda)
     e os botões trocados pra MaterialButton (ripple nativo, ícone
     embutido) em vez de CardView+TextView "de mentirinha". -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mocha_bg">

    <!-- Imagem de fundo full-bleed -->
    <ImageView
        android:id="@+id/imgBanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Banner"/>

    <!-- Gradiente cinematográfico: transparente no alto, escurece
         progressivamente até a base, onde fica o texto -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_banner_scrim"/>

    <!-- Conteúdo sobreposto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- Logo do título (TMDB), quando disponível -->
        <ImageView
            android:id="@+id/imgBannerLogo"
            android:layout_width="230dp"
            android:layout_height="84dp"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:visibility="gone"
            android:contentDescription="Logo do título"/>

        <!-- Título texto (fallback quando não tem logo) -->
        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#F5F3EF"
            android:textSize="29sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="2"
            android:shadowColor="#CC000000"
            android:shadowRadius="8"
            android:shadowDx="0"
            android:shadowDy="2"/>

        <!-- Tags de gênero/qualidade -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HD"
                android:textColor="#F5F3EF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tag_hd"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvBannerGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Em Destaque"
                android:textColor="#CCF5F3EF"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

        <!-- Botões de ação -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:layout_marginTop="18dp"
            android:gravity="start">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBannerPlay"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:text="Assistir"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@android:drawable/ic_media_play"
                app:iconTint="#000000"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="15dp"
                app:cornerRadius="10dp"
                app:backgroundTint="#F5F3EF"
                app:rippleColor="#33000000"
                app:elevation="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBannerInfo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Detalhes"
                android:textAllCaps="false"
                android:textColor="#F5F3EF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@android:drawable/ic_menu_info_details"
                app:iconTint="#F5F3EF"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="15dp"
                app:cornerRadius="10dp"
                app:strokeColor="#66F5F3EF"
                app:strokeWidth="1dp"
                app:rippleColor="#22F5F3EF"
                app:elevation="0dp"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
