<?xml version="1.0" encoding="utf-8"?>
<!--
    bottom_sheet_novo_perfil.xml
    BottomSheet de criação de novo perfil — design premium VLTV Play
    Usado em ProfilesActivity.addNewProfile()
    IDs esperados: etNovoNome, btnSalvarNovoPerfil, btnCancelarNovoPerfil
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded">

    <!-- Handle de arraste -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_handle"/>

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOVO PERFIL"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escolha um nome"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.01"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Divisor sutil -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginHorizontal="24dp"/>

    <!-- Campo de nome -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <!-- Ícone com fundo circular -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp">
            <View
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_option_icon_circle_edit"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                android:tint="#FFFFFF"
                android:contentDescription="Nome do perfil"/>
        </FrameLayout>

        <EditText
            android:id="@+id/etNovoNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:hint="Nome do perfil"
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:background="@android:color/transparent"
            android:paddingVertical="8dp"/>
    </LinearLayout>

    <!-- Linha separadora abaixo do campo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"/>

    <!-- Divisor antes dos botões -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"/>

    <!-- Botão: Salvar (verde/confirmação) -->
    <LinearLayout
        android:id="@+id/btnSalvarNovoPerfil"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp">
            <View
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_option_icon_circle_avatar"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_edit"
                android:tint="#FFFFFF"
                android:contentDescription="Salvar"/>
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Criar Perfil"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="#44FFFFFF"
            android:contentDescription=""/>
    </LinearLayout>

    <!-- Divisor antes de cancelar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"/>

    <!-- Botão: Cancelar (vermelho/destrutivo) -->
    <LinearLayout
        android:id="@+id/btnCancelarNovoPerfil"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp">
            <View
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_option_icon_circle_delete"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_delete"
                android:tint="#FFFFFF"
                android:contentDescription="Cancelar"/>
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Cancelar"
            android:textColor="#FF4444"
            android:textSize="15sp"
            android:fontFamily="sans-serif"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="#44FF4444"
            android:contentDescription=""/>
    </LinearLayout>

    <!-- Espaço inferior para navigation bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp"/>

</LinearLayout>
