<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_kids_root_gradient">

    <!-- ══ FUNDO ESTRELADO ══════════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/imgStarsBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.30"
        android:src="@drawable/bg_stars_kids"/>

    <!-- ══ VINHETA (legibilidade no topo/base, sem apagar as cores) ═════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_kids_gradient_overlay"/>

    <!-- ══ CONTEÚDO PRINCIPAL ════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── HEADER ─────────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/headerKids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <!-- Botão voltar -->
            <LinearLayout
                android:id="@+id/btnBackKids"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:background="@drawable/bg_kids_btn_back"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"/>
            </LinearLayout>

            <!-- Logo/título ÁREA KIDS centralizado, em formato de chip -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_kids_pill_pink"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌈"
                    android:textSize="16sp"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ÁREA KIDS"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨"
                    android:textSize="16sp"
                    android:layout_marginStart="6dp"/>

            </LinearLayout>

            <!-- Botão de busca (agora filtra o catálogo aqui dentro mesmo,
                 nunca sai da Área Kids) -->
            <LinearLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:background="@drawable/bg_kids_btn_back"
                android:id="@+id/btnSearchKids"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="16sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ── BARRA DE BUSCA (expansível) ───────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutSearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etSearchKids"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_kids_search_input"
                android:hint="🧸 Buscar desenhos, filmes..."
                android:textColorHint="#AAFFFFFF"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="18dp"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:focusable="true"
                android:focusableInTouchMode="true"/>

            <!-- Busca por voz — pensado pra criança que ainda não digita/lê bem -->
            <LinearLayout
                android:id="@+id/btnVoiceKids"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:background="@drawable/bg_kids_btn_back"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎤"
                    android:textSize="16sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnCloseSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_kids_btn_back"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- ── SCROLL PRINCIPAL ───────────────────────────────────────────── -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- ── CANAIS HUB (escondido durante a busca) ───────────── -->
                <LinearLayout
                    android:id="@+id/sectionHubWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_kids_card_cyan"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_kids_pill_cyan"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ "
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Canais Favoritos"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHubChannels"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:clipToPadding="false"/>

                </LinearLayout>

                <!-- ── CONTINUAR ASSISTINDO ─────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/layoutContinueHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_kids_pill_yellow"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍿 "
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvTitleRecent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Continuar Assistindo"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentKids"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:clipToPadding="false"
                    android:visibility="gone"
                    android:layout_marginBottom="20dp"/>

                <!-- ── FILMES E ANIMAÇÕES ───────────────────────────────── -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_kids_pill_pink"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎨 "
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvSectionMovies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filmes e Animações"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMoviesKids"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:clipToPadding="false"
                    android:layout_marginBottom="20dp"/>

                <!-- ── SÉRIES E DESENHOS ────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_kids_pill_green"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌟 "
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvSectionSeries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Séries e Desenhos"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSeriesKids"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:clipToPadding="false"
                    android:layout_marginBottom="8dp"/>

                <!-- ── MENSAGEM "NADA ENCONTRADO" (busca sem resultado) ──── -->
                <TextView
                    android:id="@+id/tvSemResultados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🙈 Não encontramos nada com esse nome.\nQue tal tentar outra palavra?"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:paddingHorizontal="32dp"
                    android:paddingVertical="24dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ── BOTTOM NAVIGATION ─────────────────────────────────────────── -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A0D2E"
            app:itemIconTint="@color/white"
            app:itemTextColor="@color/white"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu_kids"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
