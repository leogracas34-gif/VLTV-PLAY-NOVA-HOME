<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWide"
    android:layout_width="200dp"
    android:layout_height="121dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="4dp"
    android:focusable="true"
    android:clickable="true"
    app:cardBackgroundColor="#111118"
    app:cardCornerRadius="10dp"
    app:cardElevation="6dp">

    <!-- ✅ Pôster e barra de progresso em áreas separadas (LinearLayout
         vertical) em vez de sobrepostas — a barra fica numa faixa fina
         abaixo do pôster, nunca mais em cima dele. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/ivPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_card_scrim"/>

            <!-- ✅ logo do título (clearlogo TMDB), estilo Netflix. -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"/>

            <!-- ✅ Selos também no card largo — barra sólida de largura total,
                 mesmo formato do card vertical. -->
            <LinearLayout
                android:id="@+id/llBadgeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvBadgeNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="NOVIDADE"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.03"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_badge_status_bar"/>

                <TextView
                    android:id="@+id/tvBadgeNewLine2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="EM BREVE"
                    android:textColor="@color/mocha_gold_darkest"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.03"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="4dp"
                    android:background="@color/white"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- ✅ Selo TOP 10 encaixado no canto superior esquerdo, sem
                 margem, como se fizesse parte da própria capa. -->
            <TextView
                android:id="@+id/tvBadgeTop10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="0dp"
                android:text="TOP 10"
                android:textColor="@color/black"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:paddingStart="9dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_badge_top10"
                android:visibility="gone"/>

            <!-- Ícone play centralizado ao focar -->
            <ImageView
                android:id="@+id/ivPlayIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_circle"
                android:alpha="0"
                android:contentDescription="Play"/>

        </FrameLayout>

        <!-- ✅ Barra de progresso (Continuar Assistindo) — abaixo do
             pôster, usando o MESMO drawable da tela de Detalhes
             (progress_horizontal_disney), então a cor azul (#0072D2)
             fica sempre idêntica nas duas telas, sem hex duplicado. -->
        <ProgressBar
            android:id="@+id/pbProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginHorizontal="0dp"
            android:progress="40"
            android:progressDrawable="@drawable/progress_horizontal_disney"
            android:visibility="gone"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
