<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWide"
    android:layout_width="200dp"
    android:layout_height="115dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="4dp"
    android:focusable="true"
    android:clickable="true"
    app:cardBackgroundColor="#111118"
    app:cardCornerRadius="10dp"
    app:cardElevation="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_card_scrim"/>

        <!-- Barra de progresso (Continuar Assistindo) -->
        <ProgressBar
            android:id="@+id/pbProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="8dp"
            android:progress="40"
            android:progressTint="#D9A24B"
            android:progressBackgroundTint="#44FFFFFF"
            android:visibility="gone"/>

        <!-- ✅ NOVO: logo do título (clearlogo TMDB), estilo Netflix. -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:shadowColor="#CC000000"
            android:shadowRadius="4"/>

        <!-- ✅ NOVO: selos também no card largo — Netflix mostra "NOVOS
             EPISÓDIOS" etc. até em Continuar Assistindo. -->
        <TextView
            android:id="@+id/tvBadgeNew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:text="NOVIDADE"
            android:textColor="@color/mocha_gold"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_badge_status"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvBadgeTop10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:text="TOP 10"
            android:textColor="@color/black"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_badge_top10"
            android:visibility="gone"/>

        <!-- Ícone play centralizado ao focar -->
        <ImageView
            android:id="@+id/ivPlayIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_circle"
            android:alpha="0"
            android:contentDescription="Play"/>

    </FrameLayout>

</androidx.cardview.widget.CardView>
