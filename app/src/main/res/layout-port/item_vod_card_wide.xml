<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWide"
    android:layout_width="204dp"
    android:layout_height="125dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="4dp"
    android:focusable="true"
    android:clickable="true"
    app:cardBackgroundColor="#111118"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="#1FF5F3EF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/ivPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_card_scrim"/>

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"/>

            <!-- ✅ Selos em formato de pill, igual ao card vertical -->
            <LinearLayout
                android:id="@+id/llBadgeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvBadgeNew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="NOVIDADE"
                    android:textColor="@color/white"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_section_pill"/>

                <TextView
                    android:id="@+id/tvBadgeNewLine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="EM BREVE"
                    android:textColor="@color/brand_red_darkest"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.03"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_section_pill"
                    android:backgroundTint="@color/white"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- ✅ Selo TOP 10 — mantido -->
            <TextView
                android:id="@+id/tvBadgeTop10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="0dp"
                android:text="TOP 10"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:paddingStart="9dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_badge_top10"
                android:visibility="gone"/>

            <!-- Ícone play ao focar — mantido -->
            <ImageView
                android:id="@+id/ivPlayIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_circle"
                android:alpha="0"
                android:contentDescription="Play"/>

        </FrameLayout>

        <!-- Barra de progresso (Continuar Assistindo) — mesmo drawable
             de sempre, cor idêntica à tela de Detalhes -->
        <ProgressBar
            android:id="@+id/pbProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:progress="40"
            android:progressDrawable="@drawable/progress_horizontal_disney"
            android:visibility="gone"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
