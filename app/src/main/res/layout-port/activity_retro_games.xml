<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#0D0D0D">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRetroGames"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="true"
        android:paddingTop="100dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:id="@+id/layoutRetroTabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_retro_tabs_container"
        android:padding="4dp"
        android:visibility="gone"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tabRetroClassicos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/retro_tab_classicos"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_retro_tab_selected"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabRetroN64"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/retro_tab_n64"
            android:textColor="#999999"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_retro_tab_unselected"
            android:clickable="true"
            android:focusable="true" />

        <!-- ✅ NOVO: 3ª aba, mesmo padrão visual das outras duas -->
        <TextView
            android:id="@+id/tabRetroPs1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/retro_tab_ps1"
            android:textColor="#999999"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_retro_tab_unselected"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressRetroGames"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textRetroEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone"
        android:text="@string/retro_games_empty" />

</FrameLayout>
