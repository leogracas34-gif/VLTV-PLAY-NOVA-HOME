<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     HOME — REDESIGN COMPLETO (só pasta layout-port / celular)
     ============================================================
     Tudo que o HomeActivity.kt referencia via ViewBinding continua
     com o MESMO id de antes (conferido em HomeActivity.kt e
     HomeRowAdapter.kt antes de mexer): headerLayout, tvHeaderTitle,
     ivLogo, bannerViewPager, cardLiveTv, cardMovies, cardSeries,
     cardDownloads, cardFeaturedBanner + seus filhos, cardRetroGames,
     cardGameBanner + seus filhos, layoutContinueHeader,
     rvContinueWatching, rvTop10Movies, rvRecentlyAdded, rvTop10Series,
     rvRecentSeries, rvNovidades, bottomNavigation. Nada disso foi
     renomeado — só o visual/estrutura ao redor mudou.

     O que mudou de verdade:
     - Header flutuante com acabamento "vidro" (bg_header_glass).
     - Banner hero mais alto e cinematográfico, com uma faixa de
       transição (bg_hero_bottom_fade) em vez de cortar seco.
     - Os 4 atalhos (Ao vivo/Filmes/Séries/Downloads) viraram um único
       painel "dock" flutuante que sobrepõe a base do banner, em vez de
       4 cards soltos.
     - Destaque da Semana (Firebase) virou um card editorial: imagem no
       topo + bloco de texto sólido embaixo (mais legível que texto em
       cima da imagem com scrim).
     - Jogos retrô e Jogo ao vivo (Firebase) continuam como cards
       compactos, só que redesenhados (cantos maiores, degradê novo).
     - Cabeçalhos de fileira padronizados com uma pill de destaque
       (TOP 10 / NOVO) em vez da barrinha colorida simples.
     - Bottom nav com cantos superiores mais arredondados
       (bg_bottom_nav_v2 — arquivo novo, não mexe na TV). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mocha_bg">

    <!-- HEADER FLUTUANTE — mesmos ids de antes; visibilidade
         controlada 100% via Kotlin (nenhuma referência encontrada no
         código atual, mas mantido por segurança/uso futuro). -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="18dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_glass"
        android:elevation="20dp"
        android:translationZ="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/mocha_cream"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher"
            android:scaleType="fitCenter"
            android:contentDescription="Logo"
            android:visibility="gone"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

    </LinearLayout>

    <!-- SCROLL PRINCIPAL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- ================= BANNER HERO ================= -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="460dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/bannerViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:clipChildren="false"/>

                <!-- Faixa de transição pro resto da página, em vez de
                     corte seco entre o hero e o painel de atalhos -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_hero_bottom_fade"/>

            </FrameLayout>

            <!-- ========= PAINEL "DOCK" DE ATALHOS =========
                 Sobrepõe a base do hero (margem negativa). Reúne os 4
                 botões de categoria num único bloco de vidro, com
                 divisores finos entre eles. IDs individuais mantidos
                 (cardLiveTv/cardMovies/cardSeries/cardDownloads) — o
                 Kotlin só usa métodos genéricos de View (click, foco,
                 visibilidade), então trocar de CardView pra LinearLayout
                 aqui é seguro. -->
            <LinearLayout
                android:id="@+id/mainButtonsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="-34dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_quick_actions_panel"
                android:elevation="10dp"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:id="@+id/cardLiveTv"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📡" android:textSize="20sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ao vivo" android:textColor="#F5F3EF" android:textSize="10.5sp" android:textStyle="bold" android:letterSpacing="0.02" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/divider_quick_action"/>

                <LinearLayout
                    android:id="@+id/cardMovies"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎬" android:textSize="20sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Filmes" android:textColor="#F5F3EF" android:textSize="10.5sp" android:textStyle="bold" android:letterSpacing="0.02" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/divider_quick_action"/>

                <LinearLayout
                    android:id="@+id/cardSeries"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎭" android:textSize="20sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Séries" android:textColor="#F5F3EF" android:textSize="10.5sp" android:textStyle="bold" android:letterSpacing="0.02" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/divider_quick_action"/>

                <LinearLayout
                    android:id="@+id/cardDownloads"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_download_box_premium"
                        android:contentDescription="Downloads"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Downloads" android:textColor="#F5F3EF" android:textSize="10.5sp" android:textStyle="bold" android:letterSpacing="0.02" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ========= DESTAQUE DA SEMANA (Firebase) =========
                 Card editorial: imagem no topo + bloco de texto sólido
                 embaixo (mais legível que texto em cima da imagem). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeaturedBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="22dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#14141A"
                app:strokeWidth="1dp"
                app:strokeColor="#26C1443B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="188dp">

                        <ImageView
                            android:id="@+id/imgFeaturedBanner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/gradient_card_bottom"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="14dp"
                            android:text="Destaque da semana"
                            android:textColor="#F5F3EF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:background="@drawable/bg_featured_tag_v2"/>

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tvFeaturedTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nome do Filme"
                            android:textColor="#F5F3EF"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/tvFeaturedSynopsis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sinopse do filme ou série aparece aqui, resumida em poucas linhas."
                            android:textColor="#ADABA5"
                            android:textSize="12.5sp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:layout_marginTop="5dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:orientation="horizontal"
                            android:layout_marginTop="14dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFeaturedAssistir"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="8dp"
                                android:text="Assistir"
                                android:textAllCaps="false"
                                android:textColor="#000000"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@android:drawable/ic_media_play"
                                app:iconTint="#000000"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="14dp"
                                app:cornerRadius="10dp"
                                app:backgroundTint="#F5F3EF"
                                app:rippleColor="#33000000"
                                app:elevation="0dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFeaturedDetalhes"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:text="Detalhes"
                                android:textAllCaps="false"
                                android:textColor="#F5F3EF"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:icon="@android:drawable/ic_menu_info_details"
                                app:iconTint="#F5F3EF"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="14dp"
                                app:cornerRadius="10dp"
                                app:strokeColor="#66F5F3EF"
                                app:strokeWidth="1dp"
                                app:rippleColor="#22F5F3EF"
                                app:elevation="0dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========= JOGOS RETRÔ (Firebase) — card compacto ========= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRetroGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="18dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_retro_card_v2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕹️"
                        android:textSize="30sp"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jogos retrô"
                                android:textColor="#F5F3EF"
                                android:textSize="16.5sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Novo"
                                android:textColor="#F5F3EF"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                android:background="@drawable/bg_badge_novo"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Clássicos de vídeo game direto no app, sem baixar nada"
                            android:textColor="#F5E6C8"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="3dp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#F5F3EF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========= JOGO AO VIVO / PLACAR (Firebase) — card compacto ========= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGameBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/transparent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_game_card_v2">

                    <ImageView
                        android:id="@+id/imgGameBanner"
                        android:layout_width="match_parent"
                        android:layout_height="118dp"
                        android:scaleType="centerCrop"
                        android:alpha="0.35"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="118dp"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="7dp"
                                    android:layout_height="7dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_live_dot"/>

                                <TextView
                                    android:id="@+id/tvGameBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Em breve"
                                    android:textColor="#F5F3EF"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.1"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvGameTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Brasil x Escócia"
                                android:textColor="#F5F3EF"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                            <TextView
                                android:id="@+id/tvGameDatetime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18 de Junho  •  16h00 (Brasília)"
                                android:textColor="#E0DAD8"
                                android:textSize="12sp"
                                android:layout_marginTop="3dp"/>

                            <TextView
                                android:id="@+id/tvGameChannel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📺  Globo / SporTV"
                                android:textColor="#F5F3EF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▶"
                            android:textColor="#F5F3EF"
                            android:textSize="24sp"
                            android:alpha="0.85"
                            android:layout_marginStart="12dp"/>

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ========= CONTINUAR ASSISTINDO ========= -->
            <LinearLayout
                android:id="@+id/layoutContinueHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvContinueWatching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continuar Assistindo"
                    android:textColor="#F5F3EF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvContinueWatching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:visibility="gone"/>

            <!-- ========= TOP 10 FILMES ========= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top 10 Filmes Hoje"
                    android:textColor="#F5F3EF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOP 10"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_section_pill"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTop10Movies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- ========= FILMES PARA VOCÊ ========= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filmes Para Você"
                    android:textColor="#F5F3EF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentlyAdded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- ========= TOP 10 SÉRIES ========= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top 10 Séries Hoje"
                    android:textColor="#F5F3EF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOP 10"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_section_pill"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTop10Series"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- ========= SÉRIES PARA VOCÊ ========= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Séries Para Você"
                    android:textColor="#F5F3EF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentSeries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- ========= NOVIDADES ========= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Novidades"
                    android:textColor="#F5F3EF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOVO"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_section_pill"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNovidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="26dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION — mesmos ids/menu/estilo de antes, só o
         drawable de fundo mudou (bg_bottom_nav_v2, arquivo novo — não
         mexe no visual da TV, que continua usando bg_bottom_nav). -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav_v2"
        android:elevation="16dp"
        android:translationZ="16dp"
        android:paddingTop="8dp"
        android:focusable="true"
        android:focusableInTouchMode="false"
        app:itemIconTint="@drawable/bottom_nav_tint"
        app:itemTextColor="@drawable/bottom_nav_tint"
        app:itemIconSize="25dp"
        app:itemActiveIndicatorStyle="@style/Vltv.BottomNav.ActiveIndicator"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
