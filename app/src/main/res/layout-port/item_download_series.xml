<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#14141C"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- ── Capa da série ────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="62dp"
            android:layout_height="92dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0A0A14">

            <ImageView
                android:id="@+id/imgSeriesPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>

        </androidx.cardview.widget.CardView>

        <!-- ── Nome + selo "SÉRIE" + contagem + progresso ────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvSeriesTagLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SÉRIE"
                android:textColor="#B0B3FF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_series_tag_pill"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSeriesName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvSeriesEpisodeCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#A6FFFFFF"
                android:textSize="11.5sp"/>

            <!-- Barra de progresso agregada (só aparece se algum episódio estiver baixando) -->
            <LinearLayout
                android:id="@+id/layoutProgressSeries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/pbSeriesLinear"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:progressTint="#E50914"
                    android:progressBackgroundTint="#2A2A34"
                    android:max="100"
                    android:progress="0"/>

                <TextView
                    android:id="@+id/tvSeriesPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#E50914"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:text="0%"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ── Ações: abrir episódios + excluir série inteira ────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/btnAbrirEpisodios"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:background="@drawable/bg_download_action_circle">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chevron_right"/>

            </FrameLayout>

            <ImageView
                android:id="@+id/btnExcluirSerie"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:padding="7dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#77FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
