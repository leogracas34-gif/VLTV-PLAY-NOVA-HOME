<?xml version="1.0" encoding="utf-8"?>
<!-- NOVO HOME — menu inferior redesenhado: mantém a ideia da versão
     antiga (linha de brilho vermelha no topo + corpo quase-preto com
     cantos superiores arredondados), só que com raio maior (24dp) e
     degradê um pouco mais suave, pra combinar com o resto da tela nova.
     Arquivo separado (bg_bottom_nav_v2) pra não alterar o visual do
     menu inferior da TV (layout/), que continua usando bg_bottom_nav. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00C1443B"
                android:centerColor="#99C1443B"
                android:endColor="#00C1443B"/>
        </shape>
    </item>

    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"/>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#151517"
                android:endColor="#0B0B0C"/>
        </shape>
    </item>

</layer-list>
