<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Linha de brilho no topo, na cor de acento (ambar) da marca -->
    <item android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00D9A24B"
                android:centerColor="#80D9A24B"
                android:endColor="#00D9A24B"/>
        </shape>
    </item>

    <!-- Corpo do menu: quase preto, cantos superiores arredondados -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#131315"
                android:endColor="#0B0B0C"/>
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"/>
        </shape>
    </item>

</layer-list>
