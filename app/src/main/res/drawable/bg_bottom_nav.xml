<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Linha de brilho no topo, na cor azul da marca -->
    <item android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#001F80E0"
                android:centerColor="#801F80E0"
                android:endColor="#001F80E0"/>
        </shape>
    </item>

    <!-- Corpo do menu: gradiente escuro com cantos superiores arredondados -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#0C0C16"
                android:endColor="#070710"/>
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"/>
        </shape>
    </item>

</layer-list>
