<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado focado (D-pad) — destaque mais forte, borda ciano -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:startColor="#1F3A4D"
                        android:endColor="#122430"
                        android:angle="135" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="2dp"
                        android:color="#00C2FF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Estado padrão (sem foco) -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:startColor="#1A2B3D"
                        android:endColor="#0D1620"
                        android:angle="135" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#4000C2FF" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
