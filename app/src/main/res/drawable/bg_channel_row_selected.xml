<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cartão arredondado com leve preenchimento vermelho + borda fina -->
    <item
        android:left="4dp"
        android:top="3dp"
        android:right="4dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#33E50914" />
            <stroke
                android:width="1dp"
                android:color="#4DE50914" />
        </shape>
    </item>

    <!-- Barra de destaque na lateral esquerda, igual à da coluna de categorias -->
    <item
        android:left="4dp"
        android:top="3dp"
        android:bottom="3dp"
        android:width="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#E50914" />
        </shape>
    </item>

</layer-list>
