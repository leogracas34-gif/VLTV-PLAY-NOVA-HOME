<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ NOVO: pílula de status no card (Novidade / Nova Temporada / Novo
     Episódio / Em Breve) — estilo Netflix, mas na paleta mocha do app em
     vez do vermelho. Fundo escuro translúcido + borda dourada fina, pra
     não competir visualmente com o selo TOP 10 (que é sólido). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC0B0B0C" />
    <stroke android:width="1dp" android:color="@color/mocha_gold" />
    <corners android:radius="3dp" />
</shape>
