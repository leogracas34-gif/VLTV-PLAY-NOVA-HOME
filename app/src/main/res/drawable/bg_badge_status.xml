<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ Pílula de status no card (Novidade / Nova Temporada / Novo
     Episódio / Em Breve) — proporção e cantos ajustados pra ficar igual
     ao tamanho/formato do selo da Netflix (bem compacto, cantos quase
     retos), mantendo a paleta mocha do app em vez do vermelho. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E60B0B0C" />
    <stroke android:width="1dp" android:color="@color/mocha_gold" />
    <corners android:radius="2dp" />
</shape>
