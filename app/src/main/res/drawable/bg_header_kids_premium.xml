<?xml version="1.0" encoding="utf-8"?>
<!-- bg_header_kids_premium.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradiente escuro base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0D1433"
                android:endColor="#070B1A"
                android:angle="270"/>
        </shape>
    </item>
    <!-- Borda inferior sutil azul/púrpura -->
    <item android:top="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1E2A6E"/>
        </shape>
    </item>
</layer-list>
