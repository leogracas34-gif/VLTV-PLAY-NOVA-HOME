<?xml version="1.0" encoding="utf-8"?>
<!-- NOVO HOME — card "Jogos retrô" redesenhado: mesmo degradê dourado
     exclusivo da seção (games_gold*, ver colors.xml), cantos mais
     arredondados (18dp) e um filete claro por cima pra dar acabamento
     de vidro/metal. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="@color/games_gold_dark"
                android:centerColor="@color/games_gold_mid"
                android:endColor="@color/games_gold"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#40FFFFFF"/>
        </shape>
    </item>
</layer-list>
