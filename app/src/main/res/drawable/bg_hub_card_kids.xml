<?xml version="1.0" encoding="utf-8"?>
<!-- bg_hub_card_kids.xml -->
<!-- A cor de fundo é sobrescrita via código (HubAdapter) por canal.
     Este drawable define forma, bordas e overlay de gradiente. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo sólido (cor definida via código) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#1A2340"/>
        </shape>
    </item>
    <!-- Overlay escuro no rodapé para legibilidade do nome -->
    <item android:top="55dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="14dp" android:bottomRightRadius="14dp"/>
            <gradient
                android:startColor="#00000000"
                android:endColor="#CC000000"
                android:angle="270"/>
        </shape>
    </item>
    <!-- Borda sutil -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#2A3A7A"/>
        </shape>
    </item>
</layer-list>
