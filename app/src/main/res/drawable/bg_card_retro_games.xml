<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradiente base: roxo → magenta, clima "arcade" -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#6D28D9"
                android:centerColor="#9333EA"
                android:endColor="#DB2777" />
        </shape>
    </item>

    <!-- Borda neon fina por cima, pra dar aquele contorno "brilhando" -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>

</layer-list>
