<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradiente ambar/terracota — unico momento de cor saturada da Home,
         reservado pra esse card promocional -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#8A5A1E"
                android:centerColor="#B97328"
                android:endColor="#D9A24B" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#40F5F3EF" />
        </shape>
    </item>

</layer-list>
