<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0221">

    <TextView
        android:id="@+id/btnBackMovieDownloadKids"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="←"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_kids_btn_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imgMoviePosterKids"
        android:layout_width="190dp"
        android:layout_height="280dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:background="#1A1A2E"
        app:layout_constraintTop_toBottomOf="@id/btnBackMovieDownloadKids"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvMovieNameKids"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="22sp"
        app:layout_constraintTop_toBottomOf="@id/imgMoviePosterKids"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="700dp" />

    <TextView
        android:id="@+id/tvMovieStatusKids"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/tvMovieNameKids"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/pbMovieProgressKids"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="22dp"
        app:indicatorColor="#E91E8C"
        app:trackColor="#332B2B45"
        app:trackThickness="7dp"
        app:layout_constraintTop_toBottomOf="@id/tvMovieStatusKids"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvMoviePercentKids"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/pbMovieProgressKids"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnMoviePrimaryKids"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:backgroundTint="#E91E8C"
        android:textColor="#FFFFFF"
        android:focusable="true"
        android:nextFocusDown="@id/btnMovieSecondaryKids"
        app:layout_constraintTop_toBottomOf="@id/tvMoviePercentKids"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="480dp" />

    <Button
        android:id="@+id/btnMovieSecondaryKids"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:backgroundTint="#232336"
        android:textColor="#FFFFFF"
        android:focusable="true"
        android:nextFocusUp="@id/btnMoviePrimaryKids"
        android:nextFocusDown="@id/btnVerDetalhesFilmeKids"
        app:layout_constraintTop_toBottomOf="@id/btnMoviePrimaryKids"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="480dp" />

    <Button
        android:id="@+id/btnVerDetalhesFilmeKids"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:text="Ver detalhes"
        android:textAllCaps="false"
        android:backgroundTint="#00000000"
        android:textColor="#AAAAAA"
        android:focusable="true"
        android:nextFocusUp="@id/btnMovieSecondaryKids"
        app:layout_constraintTop_toBottomOf="@id/btnMovieSecondaryKids"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="480dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
