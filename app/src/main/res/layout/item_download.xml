<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#14141C"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- ── Capa ─────────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="62dp"
            android:layout_height="92dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0A0A14">

            <ImageView
                android:id="@+id/imgPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>

        </androidx.cardview.widget.CardView>

        <!-- ── Nome + detalhes + status ─────────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvDownloadName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvDownloadEpisodeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#99FFFFFF"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"/>

            <!-- Linha de status: ícone de celular + "No dispositivo" (concluído),
                 tamanho do arquivo, ou mensagem de erro -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/imgStatusPhone"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_phone_outline"
                    app:tint="#88FFFFFF"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvDownloadPath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A6FFFFFF"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- Barra de progresso linear + % (só aparece baixando) -->
            <LinearLayout
                android:id="@+id/layoutProgressDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/pbDownloadLinear"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:progressTint="#E50914"
                    android:progressBackgroundTint="#2A2A34"
                    android:max="100"
                    android:progress="0"/>

                <TextView
                    android:id="@+id/tvDownloadPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#E50914"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:text="0%"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ── Ações: abrir/cancelar + excluir ──────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Botão principal: seta premium (concluído) ou X (cancelar, baixando) —
                 fundo elevado e discreto, sem o vermelho "estourado" de antes -->
            <FrameLayout
                android:id="@+id/btnDownloadPrimaryAction"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:background="@drawable/bg_download_action_circle">

                <ImageView
                    android:id="@+id/imgPrimaryAction"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_circle"
                    app:tint="#FFFFFF"/>

            </FrameLayout>

            <!-- Botão excluir (lixeira) — só aparece quando concluído/erro -->
            <ImageView
                android:id="@+id/btnDownloadDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:padding="7dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#77FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
