<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPoster"
    android:layout_width="180dp"
    android:layout_height="100dp"
    android:layout_margin="6dp"
    android:focusable="true"
    android:clickable="true"
    app:cardBackgroundColor="#202020"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_black_bottom"/>

        <!-- ✅ NOVO: logo do título (clearlogo TMDB), estilo Netflix. -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:padding="8dp"
            android:text="Título do Filme"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- ✅ Selo de status — mesmo do layout retrato, compacto pro card
             menor (180x100dp). -->
        <TextView
            android:id="@+id/tvBadgeNew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:text="NOVIDADE"
            android:textColor="@color/mocha_gold"
            android:textSize="7sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:background="@drawable/bg_badge_status"
            android:visibility="gone"/>

        <!-- ✅ Selo TOP 10 — canto oposto ao de status pra não sobrepor
             quando os dois aparecem juntos. -->
        <TextView
            android:id="@+id/tvBadgeTop10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:text="TOP 10"
            android:textColor="@color/black"
            android:textSize="7sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:background="@drawable/bg_badge_top10"
            android:visibility="gone"/>

    </FrameLayout>

</androidx.cardview.widget.CardView>
