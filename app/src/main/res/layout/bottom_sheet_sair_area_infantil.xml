<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="260dp"
    android:paddingVertical="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_premium"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="40sp"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/tvTituloSairKids"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sair da Área Infantil?"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvMensagemSairKids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Você vai voltar para a tela de seleção de perfil, onde pode escolher qualquer perfil."
            android:textColor="#AAAAAA"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="28dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btnCancelarSairKids"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="Cancelar"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:background="@drawable/selector_downloads_premium"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusRight="@id/btnConfirmarSairKids"/>

            <TextView
                android:id="@+id/btnConfirmarSairKids"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Sair"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:background="@drawable/bg_botao_sair_premium"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@id/btnCancelarSairKids"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
