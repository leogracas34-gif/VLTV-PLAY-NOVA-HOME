<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar quadrado com cantos arredondados — estilo Netflix.
         O recorte é feito via Canvas no Kotlin (ProfilesActivity.exibirAvatar).
         Borda de foco (D-pad) via selector no FrameLayout. -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/selector_profile_avatar_focus"
        android:padding="4dp">

        <ImageView
            android:id="@+id/ivProfileAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

        <!-- Ícone de edição (aparece no modo editar) -->
        <ImageView
            android:id="@+id/ivEditOverlay"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:src="@android:drawable/ic_menu_edit"
            android:background="#CC000000"
            android:padding="5dp"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Nome do perfil -->
    <TextView
        android:id="@+id/tvProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="130dp"/>

</LinearLayout>
