<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="720dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_marginBottom="32dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp">

        <ImageView
            android:id="@+id/imgFundoNovidade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_card_scrim"/>

        <View android:id="@+id/btnPlayTrailer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

    </FrameLayout>

    <ImageView
        android:id="@+id/imgLogoNovidade"
        android:layout_width="260dp"
        android:layout_height="80dp"
        android:layout_marginTop="14dp"
        android:scaleType="fitStart"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvTituloNovidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:ellipsize="end"
        android:maxLines="2"/>

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#E50914"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"/>

    <TextView
        android:id="@+id/tvSinopseNovidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="#CCCCCC"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/tvMensagemDisponibilidade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#88FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/containerBotoesAtivos"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:id="@+id/btnAssistirNovidade"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusRight="@id/btnMinhaListaNovidade">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="#000000"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSISTIR"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.05"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMinhaListaNovidade"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_detalhes"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusLeft="@id/btnAssistirNovidade">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETALHES"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.05"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>

    <View android:id="@+id/tvNumeroTop10"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>
    <View android:id="@+id/containerBotaoAviso"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="#1AFFFFFF"/>

</LinearLayout>
