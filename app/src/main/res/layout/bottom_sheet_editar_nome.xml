<?xml version="1.0" encoding="utf-8"?>
<!--
    bottom_sheet_editar_nome.xml (TV)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="220dp"
    android:paddingVertical="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet_rounded">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar Nome"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.02"
            android:paddingHorizontal="28dp"
            android:paddingTop="24dp"
            android:paddingBottom="6dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="28dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etEditarNome"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingHorizontal="18dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#66FFFFFF"
                android:hint="Nome do perfil"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:background="@drawable/bg_input_dark"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/btnSalvarNome"/>
        </FrameLayout>

        <!-- Botões em linha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:gravity="end">

            <TextView
                android:id="@+id/btnCancelarNome"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="CANCELAR"
                android:textColor="#888888"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:paddingHorizontal="22dp"
                android:background="@drawable/selector_downloads_premium"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/etEditarNome"
                android:nextFocusRight="@id/btnSalvarNome"/>

            <TextView
                android:id="@+id/btnSalvarNome"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="SALVAR"
                android:textColor="#E50914"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:paddingHorizontal="22dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/selector_downloads_premium"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/etEditarNome"
                android:nextFocusLeft="@id/btnCancelarNome"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
