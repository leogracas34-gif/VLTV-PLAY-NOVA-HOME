<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ✅ Paleta "brand red" — troca do dourado (mocha_gold) por um
         vermelho mais fechado/vinho, pra diferenciar este app do VLTV
         Play (que já usa vermelho estilo Netflix) sem repetir a mesma
         cor. brand_red é o acento principal (bordas, botões, selos,
         destaques); brand_red_mid e brand_red_dark são os tons mais
         escuros do mesmo degradê (usados em bg_home_red.xml e onde
         antes havia o degradê dourado). Os nomes antigos (mocha_gold*)
         foram renomeados pra refletir a cor de verdade. -->
    <color name="brand_red">#C1443B</color>
    <color name="brand_red_mid">#96332B</color>
    <color name="brand_red_dark">#96332B</color>
    <color name="brand_red_darkest">#5E1F1C</color>

    <!-- ✅ NOVO: o dourado antigo (mocha_gold) não desapareceu — ele
         virou o acento EXCLUSIVO da seção "Jogos retrô" (ver
         bg_card_retro_games.xml). Como o resto do app agora é vermelho,
         o dourado passa a funcionar como um destaque natural pra essa
         área especial, sem precisar inventar uma terceira cor. -->
    <color name="games_gold">#D9A24B</color>
    <color name="games_gold_mid">#B97328</color>
    <color name="games_gold_dark">#8A5A1E</color>

    <!-- ✅ Fundos/textos da Home (não são a cor de acento — continuam
         quase-preto/creme independente da paleta escolhida acima). -->
    <color name="mocha_bg">#0B0B0C</color>
    <color name="mocha_card">#17171A</color>
    <color name="mocha_cream">#F5F3EF</color>
    <color name="mocha_muted">#ADABA5</color>

    <color name="background_dark">#0B0B0C</color>
    <color name="gray_text">#B0B0B0</color>

    <!-- Cores do Tema -->
    <color name="colorPrimary">@color/brand_red</color>
    <color name="colorPrimaryVariant">@color/brand_red_dark</color>
    <color name="colorOnPrimary">@color/white</color>
    <color name="colorSecondary">@color/brand_red</color>
</resources>
